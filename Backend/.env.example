DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Services_Web_App
DB_CONNECTION_LIMIT=10

JWT_SECRET=change-this-to-a-long-random-secret

NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# ─── Email Sending Configuration ──────────────────────────────────────────────
#
# EMAIL_DEV_MODE=true  → emails are NOT sent; links are printed to the console
# EMAIL_DEV_MODE=false → emails are sent using SMTP settings below
#
EMAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Works For You
EMAIL_FROM_ADDRESS=
EMAIL_DEV_MODE=false

# Optional: set to receive contact-form submissions by email
ADMIN_NOTIFICATION_EMAIL=

# ─── Gmail SMTP Setup ─────────────────────────────────────────────────────────
#
# To send emails via a client-owned Gmail account:
#   1. Use a Gmail account owned by the client (e.g. worksforyou@gmail.com).
#   2. Enable 2-Step Verification on that Google account.
#   3. Go to Google Account → Security → App Passwords.
#   4. Generate an App Password for "Mail" / "Other (custom name)".
#   5. Set EMAIL_USER to the Gmail address.
#   6. Set EMAIL_APP_PASSWORD to the generated App Password (16 characters, no spaces).
#   7. Set EMAIL_FROM_ADDRESS to the same Gmail address (or a verified alias).
#   8. Do NOT use the regular Gmail login password — only App Passwords work with SMTP.
#
# ─── Switching to Another Email Provider ──────────────────────────────────────
#
# To use a different SMTP provider (SendGrid, Resend SMTP relay, Mailgun, Postmark, etc.):
#   1. Update EMAIL_HOST, EMAIL_PORT, EMAIL_SECURE with the provider's SMTP settings.
#   2. Update EMAIL_USER and EMAIL_APP_PASSWORD with the provider's credentials.
#   3. Update EMAIL_FROM_ADDRESS to a verified sender address for that provider.
#   4. Restart the backend — no code changes required.
#
